# Required for the auth routes (server fails fast if DATABASE_URL is set but invalid)
DATABASE_URL=postgres://postgres:dev@localhost:5432/xiaozhi
# At least 64 bytes; generate with: openssl rand -base64 64
SESSION_SECRET=change-me-to-a-random-64-byte-secret-change-me-to-a-random-64-byte
SESSION_TTL_SECS=2592000
COOKIE_SECURE=false
SESSION_COOKIE_NAME=xz_session

# Device activation/binding
DEVICE_ACTIVATION_TTL_SECS=600

BIND_ADDR=0.0.0.0:3000
