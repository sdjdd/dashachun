# --- Server ---
BIND_ADDR=0.0.0.0:3000
PLAYBACK_PREBUFFER_MS=180
SHUTDOWN_GRACE_MS=5000

# --- Database (required) ---
DATABASE_URL=postgres://postgres:dev@localhost:5432/xiaozhi

# --- Sessions ---
SESSION_TTL_SECS=2592000
COOKIE_SECURE=true
SESSION_COOKIE_NAME=xz_session
# The signing secret is not configured here: it is auto-generated into the
# `settings` table ("security" row) on first boot and has no env override.

# --- Device activation/binding ---
DEVICE_ACTIVATION_TTL_SECS=600

# --- LLM / ASR / TTS / OTA (settings table, not env) ---
# Provider and OTA configuration lives in the Postgres `settings` table: one
# row per section, the JSON of the matching struct in src/settings.rs. The
# server exits at startup when the "llm"/"asr"/"tts" row is missing. Insert
# them once (and after every change restart to apply):
#
#   INSERT INTO settings (key, value) VALUES
#     ('llm', '{"base_url": "https://.../v1", "api_key": "...", "model": "..."}'),
#     ('asr', '{"base_url": "wss://...", "api_key": "...", "resource_id": "volc.seedasr.sauc.duration"}'),
#     ('tts', '{"base_url": "wss://...", "api_key": "...", "speaker": "...", "resource_id": "seed-tts-2.0"}'),
#     ('ota', '{"websocket_url": null, "timezone_offset": 480}');
#
# resource_id has no default; timezone_offset defaults to 480 and websocket_url
# to null (derived from the request Host).

# --- Agent (voice assistant) ---
# The per-device persona prompt lives in the `agents` table; a device is bound
# to one agent at activation. There is no env fallback: a device whose agent is
# missing is rejected at the gateway.

# --- Examples only ---
# cargo run --example asr_volc / tts_volc read these env vars directly; the
# server itself never does.
#VOLC_ASR_API_KEY=
#VOLC_ASR_BASE_URL=
#VOLC_ASR_RESOURCE_ID=
#VOLC_TTS_API_KEY=
#VOLC_TTS_BASE_URL=
#VOLC_TTS_SPEAKER=
#VOLC_TTS_RESOURCE_ID=
