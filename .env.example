# --- Server ---
BIND_ADDR=0.0.0.0:3000
PLAYBACK_PREBUFFER_MS=180
SHUTDOWN_GRACE_MS=5000

# --- Database (required) ---
DATABASE_URL=postgres://postgres:dev@localhost:5432/xiaozhi

# --- Sessions (required) ---
# At least 64 bytes; generate with: openssl rand -base64 64
SESSION_SECRET=change-me-to-a-random-64-byte-secret-change-me-to-a-random-64-byte
SESSION_TTL_SECS=2592000
COOKIE_SECURE=true
SESSION_COOKIE_NAME=xz_session

# --- Device activation/binding ---
DEVICE_ACTIVATION_TTL_SECS=600

# --- OTA ---
OTA_TIMEZONE_OFFSET=480
# Optional; when unset the websocket url is derived from the request Host.
#OTA_WEBSOCKET_URL=

# --- LLM (OpenAI-compatible Chat Completions) ---
# All three of LLM_BASE_URL/LLM_API_KEY/LLM_MODEL are required to enable the LLM.
#LLM_BASE_URL=https://api.openai.com/v1
#LLM_API_KEY=
#LLM_MODEL=
# Optional; system prompt has a built-in default.
#LLM_SYSTEM_PROMPT=
# Optional; when unset no token cap is sent.
#LLM_MAX_TOKENS=
# Optional; one of none/low/medium/high. Use "none" for reasoning models.
#LLM_REASONING_EFFORT=

# --- ASR (Volcengine bigmodel streaming) ---
# VOLC_ASR_API_KEY and VOLC_ASR_BASE_URL are required to enable the provider;
# otherwise the stub ASR is used.
#VOLC_ASR_API_KEY=
#VOLC_ASR_BASE_URL=
#VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration

# --- TTS (Volcengine bidirectional streaming) ---
# VOLC_TTS_API_KEY, VOLC_TTS_BASE_URL and VOLC_TTS_SPEAKER are required to enable
# the provider; otherwise the reply is text-only (no audio).
#VOLC_TTS_API_KEY=
#VOLC_TTS_BASE_URL=
#VOLC_TTS_SPEAKER=
#VOLC_TTS_RESOURCE_ID=seed-tts-2.0
