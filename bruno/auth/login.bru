meta {
  name: login
  type: http
  seq: 3
}

docs {
  # Login

  `POST /api/auth/login` — authenticate and start a session.

  - Body: `{ username, password }`.
  - `200` + signed session cookie; `401` for unknown user or wrong password.
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
