docs {
  # Logout

  `POST /api/auth/logout` — delete the current session and clear the cookie.

  `204` on success; `401` when not logged in.
}

post {
  url: {{baseUrl}}/api/auth/logout
  body: none
  auth: none
}

tests {
  test("status is 204", function() {
    expect(res.getStatus()).to.equal(204);
  });
}
