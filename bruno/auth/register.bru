meta {
  name: register (auto login)
  type: http
  seq: 2
}

docs {
  # Register

  `POST /api/auth/register` — create an account and auto-log in.

  - Body: `{ username, password }` (username `^[A-Za-z0-9_-]{3,32}$`, password 8–128 chars).
  - `201` + signed session cookie; `409` if the username is taken.
  - A random `username` is generated pre-request so re-runs don't collide.
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  bru.setVar("username", "u" + Math.random().toString(36).slice(2, 12));
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("returns the username", function() {
    expect(res.getBody().username).to.equal(bru.getVar("username"));
  });
}
