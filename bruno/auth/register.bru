meta {
  name: register
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  bru.setVar("username", "u" + Math.random().toString(36).slice(2, 12));
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("returns the username", function() {
    expect(res.getBody().username).to.equal(bru.getVar("username"));
  });
}
