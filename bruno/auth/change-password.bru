meta {
  name: change password
  type: http
  seq: 5
}

docs {
  # Change password

  `POST /api/auth/change-password` — change the current user's password.

  - Body: `{ current_password, new_password }` (new password 8–128 chars).
  - `204` on success; revokes every other session. `401` when logged out or the
    current password is wrong.
}

post {
  url: {{baseUrl}}/api/auth/change-password
  body: json
  auth: none
}

body:json {
  {
    "current_password": "{{password}}",
    "new_password": "{{newPassword}}"
  }
}

tests {
  test("status is 204", function() {
    expect(res.getStatus()).to.equal(204);
  });
}
