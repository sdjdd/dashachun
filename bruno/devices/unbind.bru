meta {
  name: unbind device
  type: http
  seq: 4
}

docs {
  # Unbind a device

  `DELETE /api/devices/{{clientId}}` — remove the device from the current user.

  Clears the binding and WS token, so the device must re-activate on its next OTA.
  - `204` on success; `404` if the client id is not owned by the user (or invalid).
}

delete {
  url: {{baseUrl}}/api/devices/{{clientId}}
  body: none
  auth: none
}

tests {
  test("status is 204", function() {
    expect(res.getStatus()).to.equal(204);
  });
}
