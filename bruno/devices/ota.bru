meta {
  name: ota check (first contact)
  type: http
  seq: 1
}

docs {
  # OTA check (first device contact)

  `POST /api/ota` with `Device-Id` (MAC) and `Client-Id` (board UUID) headers.

  - Unbound device → `activation { code, message, challenge, timeout_ms }` and an
    empty `websocket.token`. `message` is the numeric code; `challenge` keeps the
    firmware polling `/api/ota/activate`.
  - Bound device → a freshly rotated per-device `websocket.token`, no `activation`.
  - The test stores the code in the `activationCode` variable for `activate.bru`.
}

post {
  url: {{baseUrl}}/api/ota
  body: json
  auth: none
}

headers {
  Device-Id: aa:bb:cc:dd:ee:ff
  Client-Id: {{clientId}}
}

body:json {
  {
    "application": { "version": "1.0.0" },
    "board": { "type": "test-board" }
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("returns an activation code", function() {
    const code = res.getBody().activation.code;
    expect(code).to.have.length(6);
    bru.setVar("activationCode", code);
  });
}
